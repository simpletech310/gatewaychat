# Postgres (Vercel Postgres, Neon, Supabase, etc.). Must support pgvector.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Anthropic — Claude Haiku 4.5 is used by default (cheapest).
ANTHROPIC_API_KEY=

# Voyage AI — for embeddings (voyage-3-lite, 512-dim).
VOYAGE_API_KEY=

# Resend — for the "send_email_to_human" bot tool.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GatewayChat <notifications@yourdomain.com>

# JWT secret for admin auth (any long random string).
AUTH_SECRET=change-me-to-a-long-random-string

# Admin user bootstrapped on first run / seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Public base URL of this deployment (used in the embed snippet shown in the admin UI).
NEXT_PUBLIC_APP_URL=http://localhost:3000

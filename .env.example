# =============================================================================
# Postgres
# =============================================================================
# For Supabase: USE THE POOLER URL on Vercel (port 6543), not the direct
# connection. Supabase Dashboard → Project Settings → Database → Connection
# string → "Transaction" mode. It looks like:
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# The direct URL (db.<ref>.supabase.co:5432) is fine for local CLI / migrations,
# but will exhaust connections on Vercel's serverless runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# =============================================================================
# Supabase (for storage — chatbot logos bucket)
# =============================================================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Claude — claude-haiku-4-5-20251001 is used by default (cheapest)
# =============================================================================
ANTHROPIC_API_KEY=

# =============================================================================
# Voyage AI — embeddings (voyage-3-lite, 512-dim)
# =============================================================================
VOYAGE_API_KEY=

# =============================================================================
# Resend — for the "send_email_to_human" bot tool
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=GatewayChat <notifications@yourdomain.com>

# =============================================================================
# Auth — JWT secret for admin session cookies
# =============================================================================
AUTH_SECRET=change-me-to-a-long-random-string

# =============================================================================
# Admin login defaults (used on first login if no admin exists)
# =============================================================================
ADMIN_EMAIL=wilform.thomas@gmail.com
ADMIN_PASSWORD=power123

# =============================================================================
# Public base URL of this deployment (used in the embed snippet shown in the admin UI)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
